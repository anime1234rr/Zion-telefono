{
  "expo": {
    "name": "Zion",
    "slug": "zion-mobile",
    "scheme": "zion",
    "version": "1.0.2",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0f1117",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.lunayanet.zion"
    },
    "android": {
      "package": "com.lunayanet.zion",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f1117"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Zion necesita acceso a tus fotos para que puedas enviar imágenes y cambiar tu avatar."
        }
      ],
      "expo-asset",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-updates",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#0f1117",
          "imageWidth": 220
        }
      ],
      "expo-video",
      "./plugins/withDisableForceDark.js"
    ],
    "updates": {
      "url": "https://u.expo.dev/77756d09-764d-43a7-87fd-e12c43d66099"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "eas": {
        "projectId": "77756d09-764d-43a7-87fd-e12c43d66099"
      },
      "githubRepo": "anime1234rr/Zion-telefono",
      "mobileReleaseTagPrefix": "mobile-v"
    },
    "owner": "anime1234r"
  }
}
